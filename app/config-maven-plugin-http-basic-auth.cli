
### 1. Adicionando Módulo do MySQL ####
deploy mariadb-java-client.jar

## 2 Adicionando os DataSources do sistema de chamados e dos textos prontos ####
data-source add --name=OtrsDS --driver-name=mariadb-java-client.jar --jndi-name=java:jboss/datasources/OtrsDS --connection-url=jdbc:mariadb://172.23.0.3:3306/otrsdb --user-name=albatross18 --password=pass123 --enabled=true --valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.mysql.MySQLValidConnectionChecker --exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.mysql.MySQLExceptionSorter
data-source add --name=ProblemaDS --driver-name=mariadb-java-client.jar --jndi-name=java:jboss/datasources/ProblemaDS --connection-url=jdbc:mariadb://172.23.0.2:3306/otrsdb_textos_prontos --user-name=albatross18 --password=pass123 --enabled=true --valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.mysql.MySQLValidConnectionChecker --exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.mysql.MySQLExceptionSorter

# Configurando o ActiveMQ Remoto para a produção de mensagens JMS

# Configurando o socket-binding com o host e a porta do ActiveMQ
/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=remote-activemq-socket-binding:add(host=localhost, port=61616)

# Configurando o remote-active-mq-connector
/subsystem=messaging-activemq/remote-connector=remote-activemq-connector:add(socket-binding=remote-activemq-socket-binding)

# Configurando uma Pooled Connection Factory remota
/subsystem=messaging-activemq/pooled-connection-factory=remote-activemq-connection-factory:add(connectors=[remote-activemq-connector], entries=[java:/jms/RemoteActiveMQConnectionFactory], user=albatross18, password=pass123

# Configurando a File (Queue) de Mensageria
/subsystem=messaging-activemq/external-jms-queue=OtrsEmailQueue:add(entries=[jms.queue.OtrsEmailQueue, java:jboss/exported/jms/queue/OtrsEmailQueue]

# Criando o socket Binding com o servidor de email smtp
/socket-binding-group=standard-sockets/remote-destination-outbound-socket-binding=my-smtp-binding:add(host=sandbox.smtp.mailtrap.io, port=587)

# Criando o Mail Session
/subsystem=mail/mail-session=otrsMailSession:add(jndi-name=java:jboss/mail/OtrsMailSession)

# Definindo o socket binding criado para o Session anteriormente criado
/subsystem=mail/mail-session=otrsMailSession/server=smtp:add(outbound-socket-binding-ref=my-smtp-binding, username=905f2dd9fbc8bb, password=45f40d644a1897, tls=true)


### Autenticação ###

### 7.1 Criando o Realm JDBC (Plain Text Password) ###
/subsystem=elytron/jdbc-realm=otrs-jdbc-realm:add(principal-query=[{data-source=ProblemaDS,simple-digest-mapper={password-index=1, algorithm=simple-digest-sha-512, hash-encoding=base64},sql="SELECT u.password FROM users u WHERE u.username = ?"},{data-source=ProblemaDS,attribute-mapping=[{index=1,to=roles}],sql="SELECT r.name FROM users_roles ur INNER JOIN roles r ON ur.fk_role_id = r.id INNER JOIN users u ON u.id=ur.fk_user_id WHERE u.username = ?"}]

### 7.2 Criando o Role Decoder
/subsystem=elytron/simple-role-decoder=attribute-to-roles:add(attribute=roles)

### 7.3 Definindo o Realm criado como padrão do ApplicationDomain padrão do Wildfly ###
### Isto é necessário pelo fato do sistema fazer uso de EJBs ###
batch
/subsystem=elytron/security-domain=ApplicationDomain:write-attribute(name=realms, value=[{realm=otrs-jdbc-realm, role-decoder=attribute-to-roles}])
/subsystem=elytron/security-domain=ApplicationDomain:write-attribute(name=default-realm,value=otrs-jdbc-realm)
run-batch


## 7.2 Criando o Security Domain ####
#/subsystem=elytron/security-domain=otrsSD:add(role-decoder=attribute-to-roles, realms=[{realm=otrs-jdbc-realm,role-decoder=attribute-to-roles}],permission-mapper=default-permission-mapper)

## 7.3 Criando a Http Authentication Factory ####
#/subsystem=elytron/http-authentication-factory=otrs-http-auth:add(http-server-mechanism-factory=global,security-domain=otrsSD,mechanism-configurations=[{mechanism-name=BASIC,mechanism-realm-configurations=[{realm-name=otrs-jdbc-realm}]}])

## 7.4 Criando a Http Sec Domain
#/subsystem=undertow/application-security-domain=otrsHttpSD:add(http-authentication-factory=otrs-http-auth)

## 7.5 Criando o Subsytem ejb3
#/subsystem=ejb3/application-security-domain=otrs-ejb-sd:add(security-domain=otrsSD)


